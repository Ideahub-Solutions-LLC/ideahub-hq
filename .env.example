# ─────────────────────────────────────────────────────────────────────────────
# IdeaHub AI Team — environment variables (names only; never commit real values)
# Copy to .env.local for local development. Secrets stay on the server.
# ─────────────────────────────────────────────────────────────────────────────

# Product naming / branding (working title — change freely)
NEXT_PUBLIC_PRODUCT_NAME="IdeaHub AI Team"
NEXT_PUBLIC_COMPANY_NAME="IdeaHub"

# Database (SQLite file path for local dev). Postgres path documented in docs/ARCHITECTURE.md
DATABASE_URL="./data/ideahub.db"

# Session signing secret (32+ random bytes, e.g. `openssl rand -hex 32`)
SESSION_SECRET=""

# Seed script: password assigned to the fictional demo users (demo only).
SEED_DEMO_PASSWORD="change-me-demo"
# Demo hints are opt-in, including in development.
SHOW_DEMO_LOGINS="0"

# Clean pilot bootstrap (pnpm pilot:setup on an EMPTY database only).
# Set these locally, run setup, then remove PILOT_OWNER_PASSWORD from this file.
PILOT_OWNER_EMAIL=""
PILOT_OWNER_NAME=""
PILOT_OWNER_PASSWORD=""

# Set only behind a trusted proxy that OVERWRITES this single-address header.
# Empty means a shared address bucket. Never trust arbitrary forwarded headers.
AUTH_CLIENT_IP_HEADER=""

# AI providers — presence of a key enables the live adapter; absence = Demo provider.
# These must be API keys from a developer account. Consumer ChatGPT/Claude subscriptions
# do NOT authorize API usage; never paste session tokens or passwords here.
ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_MODEL="claude-sonnet-4-5"
OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL="gpt-4.1-mini"

# Optional provider pricing table (USD per 1M tokens) used ONLY for estimates.
# Leave empty to record units without a cost estimate. Example:
# PROVIDER_PRICING_JSON='{"anthropic:claude-sonnet-4-5":{"input":3,"output":15}}'
PROVIDER_PRICING_JSON=""

# Background job worker: "inline" runs the worker inside the Next.js server process
# (fine for local/dev). "external" means you run `pnpm worker` separately.
JOB_WORKER_MODE="inline"
JOB_WORKER_POLL_MS="2000"
JOB_MAX_CONCURRENCY="2"
JOB_TIMEOUT_MS="60000"

# Connector credentials (all Planned/Demo today; names reserved for future live adapters)
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
MS_TEAMS_APP_ID=""
MS_TEAMS_APP_SECRET=""
SMTP_URL=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
GHL_API_KEY=""
GHL_LOCATION_ID=""

# MCP discovery: exact trusted origins, comma-separated; empty denies all requests.
# Example for a local gateway: http://127.0.0.1:3988
MCP_ALLOWED_ORIGINS=""
# Optional per-server bearer credentials use MCP_<NAME>_TOKEN; values stay here.
# MCP_STUDIO_TOKEN=""
